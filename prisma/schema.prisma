generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Prisma RESETS the shadow database. It must be a separate, dedicated database (never DATABASE_URL);
  // scripts/db-guard.mjs validates this. Not needed for generate / migrate deploy.
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

enum TradingMode {
  PAPER
  LIVE
  SEMI_AUTO
  SCANNER
}

enum TradeSide {
  BUY
  SELL
}

enum TradeStatus {
  PENDING
  OPEN
  CLOSED
  FAILED
}

enum ExecutionMode {
  PAPER
  LIVE
  SEMI_AUTO
  SCANNER
}

enum BotStatus {
  STOPPED
  RUNNING
  PAUSED
  EMERGENCY_STOP
}

enum RiskEventType {
  POSITION_LIMIT
  DRAWDOWN
  VOLATILITY
  SLIPPAGE
  MANUAL_OVERRIDE
}

enum NotificationType {
  INFO
  WARNING
  ERROR
  SUCCESS
}

enum UserRole {
  ADMIN
  USER
}

enum WalletType {
  USER
  BOT_TRADING
}

enum RiskDecision {
  ACCEPT
  WATCH
  REJECT
}

enum RiskClassification {
  LOW
  MODERATE
  HIGH
  VERY_HIGH
  EXTREME
  BLOCKED
}

enum RiskPolicy {
  CONSERVATIVE
  BALANCED
  EXPLORATORY
}

enum PaperOrderStatus {
  QUEUED
  PARTIALLY_FILLED
  FILLED
  REJECTED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
  STALE
  EXECUTED
}

enum SignalDirection {
  BUY
  SELL
  WATCH
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String?
  role         UserRole @default(USER)
  /// Profile picture (max 128x128, PNG / JPEG / WebP, <= 200 KB), served by GET /api/users/:id/avatar.
  avatarImage     Bytes?
  avatarMime      String?
  avatarUpdatedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  botConfigs          BotConfig[]
  advancedStrategyConfig AdvancedStrategyConfig?
  riskConfigs         RiskConfig[]
  strategyConfigs     StrategyConfig[]
  notificationConfigs NotificationConfig[]
  wallets            Wallet[]
  auditLogs           AuditLog[]
  trades              Trade[]
  positions           Position[]
  sessions            Session[]
  riskAssessments     RiskAssessment[]
  signals             Signal[]
  paperAccounts       PaperAccount[]
  paperOrders         PaperOrder[]
    approvalRequests    ApprovalRequest[]
  backtestRuns        BacktestRun[]
    executionAttempts   ExecutionAttempt[]
  aiConfig AiConfig?
  aiAnalyses AiAnalysis[]
  newLaunchConfig NewLaunchConfig?
  launchDecisions LaunchDecision[]
  newLaunchConfigVersions NewLaunchConfigVersion[]
  newLaunchOptimizationRuns NewLaunchOptimizationRun[]
  newLaunchRecommendations NewLaunchOptimizationRecommendation[]
  trustedLoginIps     TrustedLoginIp[]
  verificationChallenges VerificationChallenge[]
}

model PaperAccount {
  id             String   @id @default(cuid())
  userId         String   @unique
  currency       String   @default("USDC")
  initialBalance Decimal  @db.Decimal(18, 8)
  cashBalance    Decimal  @db.Decimal(18, 8)
  equity         Decimal  @db.Decimal(18, 8)
  realizedPnl    Decimal  @db.Decimal(18, 8) @default(0)
  unrealizedPnl  Decimal  @db.Decimal(18, 8) @default(0)
  totalFees      Decimal  @db.Decimal(18, 8) @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders PaperOrder[]

  @@index([userId])
}

model PaperOrder {
  id                 String           @id @default(cuid())
  paperAccountId     String
  userId             String
  tokenAddress       String
  symbol             String
  side               TradeSide
  strategyName       String?
  signalId           String?
  status             PaperOrderStatus @default(QUEUED)
  requestedNotionalUsd Decimal        @db.Decimal(18, 8)
  filledNotionalUsd  Decimal        @db.Decimal(18, 8) @default(0)
  quantity           Decimal        @db.Decimal(18, 8) @default(0)
  executionPriceUsd  Decimal?       @db.Decimal(30, 18)
  feeUsd             Decimal        @db.Decimal(18, 8) @default(0)
  slippageUsd        Decimal        @db.Decimal(18, 8) @default(0)
  priorityFeeUsd     Decimal        @db.Decimal(18, 8) @default(0)
  executionDelayMs   Int            @default(0)
  partialFillRatio   Decimal?       @db.Decimal(5, 4)
  signalScore        Decimal?       @db.Decimal(5, 2)
  riskScore          Decimal?       @db.Decimal(5, 2)
  rejectionReason    String?
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  paperAccount PaperAccount @relation(fields: [paperAccountId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fills        PaperFill[]

  @@index([paperAccountId, createdAt])
  @@index([userId, createdAt])
  @@unique([signalId])
}

model PaperFill {
  id            String   @id @default(cuid())
  paperOrderId  String
  tokenAddress  String
  symbol        String
  quantity      Decimal  @db.Decimal(18, 8)
  priceUsd      Decimal  @db.Decimal(30, 18)
  notionalUsd   Decimal  @db.Decimal(18, 8)
  feeUsd        Decimal  @db.Decimal(18, 8)
  slippageUsd   Decimal  @db.Decimal(18, 8)
  filledAt      DateTime @default(now())

  paperOrder PaperOrder @relation(fields: [paperOrderId], references: [id], onDelete: Cascade)

  @@index([paperOrderId])
}

model ApprovalRequest {
  id                String         @id @default(cuid())
  userId            String
  signalId          String
  tokenId           String
  status            ApprovalStatus @default(PENDING)
  direction         TradeSide
  signalScore       Decimal        @db.Decimal(5, 2)
  riskScore         Decimal        @db.Decimal(5, 2)
  entryPrice        Decimal        @db.Decimal(30, 18)
  positionSize      Decimal        @db.Decimal(18, 8)
  stopLoss          Decimal?       @db.Decimal(30, 18)
  takeProfit        Decimal?       @db.Decimal(30, 18)
  trailingStop      Decimal?       @db.Decimal(5, 4)
  reasons           Json
  proposedOrderHash String         @unique
  proposedAt        DateTime       @default(now())
  expiresAt         DateTime
  reviewedAt        DateTime?
  executedAt        DateTime?
  rejectionReason   String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  signal Signal @relation(fields: [signalId], references: [id], onDelete: Cascade)
  token  Token  @relation(fields: [tokenId], references: [id], onDelete: Cascade)

  @@unique([userId, signalId])
  @@index([userId, status, expiresAt])
  @@index([signalId])
}

model ExecutionAttempt {
  id                String   @id @default(cuid())
  userId            String
  idempotencyKey    String
  requestFingerprint String
  state             String
  attemptCount      Int      @default(1)
  transactionSignature String?
  request           Json
  record            Json
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, state, updatedAt])
  @@index([transactionSignature])
}

model BotState {
  id        String    @id
  status    BotStatus @default(STOPPED)
  updatedAt DateTime  @updatedAt
  updatedBy String?

  @@index([status])
  @@index([updatedAt])
}

model BotStrategyConfig {
  id           String   @id @default(cuid())
  strategyName String   @unique
  isEnabled    Boolean  @default(false)
  configJson   Json
  maxExposure  Decimal? @db.Decimal(18, 8)
  maxPositions Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isEnabled])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model BotConfig {
  id                    String      @id @default(cuid())
  userId                String      @unique
  botName               String      @default("main-bot")
  tradingMode           TradingMode @default(PAPER)
  isLiveEnabled         Boolean     @default(false)
  liveApprovalCompleted Boolean     @default(false)
  isScannerEnabled      Boolean     @default(true)
  isPaperModeDefault    Boolean     @default(true)
  isEmergencyStop       Boolean     @default(false)
  status                BotStatus   @default(STOPPED)
  maxPositionSize       Decimal?    @db.Decimal(18, 8)
  maxDailyLoss          Decimal?    @db.Decimal(18, 8)
  riskThreshold         Decimal?    @db.Decimal(5, 2)
  preferredQuoteCurrency String     @default("USDC")
  maxTokenAgeHours      Int?        @default(168)
  minLiquidityUsd       Decimal?    @db.Decimal(18, 8)
  minVolumeUsd          Decimal?    @db.Decimal(18, 8)
  botTradingWalletAddress String?   @db.VarChar(255)
  /// Skip a token for this user once it has stayed blocked/unbuyable this many minutes (0 = never skip).
  skipUnbuyableAfterMinutes Int     @default(0)
  /// How long a skipped token is left out of scanning, strategy evaluation and automatic buying.
  skipUnbuyableForMinutes   Int     @default(60)
  /// How many tokens the scanner keeps in its rotating pool / the token monitor shows (10-300).
  maxMonitoredTokens        Int     @default(50)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([tradingMode])
}

model RiskConfig {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  maxPositionPercent         Decimal? @db.Decimal(5, 2)
  maxTotalExposurePercent    Decimal? @db.Decimal(5, 2)
  maxConcurrentPositions     Int?     @default(3)
  dailyLossLimitPercent      Decimal? @db.Decimal(5, 2)
  maxSlippagePercent         Decimal? @db.Decimal(5, 2)
  minSignalScore             Decimal? @db.Decimal(5, 2)
  cooldownSeconds            Int?     @default(60)
  stopLossPercent            Decimal? @db.Decimal(5, 2)
  takeProfitPercent          Decimal? @db.Decimal(5, 2)
  trailingStopPercent        Decimal? @db.Decimal(5, 2)
  /// Gain (percent above the entry fill) at which the trailing stop arms; null/0 = armed from entry (legacy).
  trailingActivationPercent  Decimal? @db.Decimal(5, 2)
  /// Optional: gain at which the stop loss is raised to the net break-even price; null/0 = disabled.
  breakEvenActivationPercent Decimal? @db.Decimal(5, 2)
  riskPolicy                 RiskPolicy @default(BALANCED)
  lowRiskMax                 Int      @default(30)
  moderateRiskMax            Int      @default(50)
  highRiskMax                Int      @default(70)
  veryHighRiskMax            Int      @default(85)
  lowPositionMultiplier      Decimal  @default(1.000) @db.Decimal(4, 3)
  moderatePositionMultiplier Decimal  @default(0.750) @db.Decimal(4, 3)
  highPositionMultiplier     Decimal  @default(0.350) @db.Decimal(4, 3)
  veryHighPositionMultiplier Decimal  @default(0.150) @db.Decimal(4, 3)
  aiAnalysisEnabled          Boolean  @default(false)
  aiRequiredForHighRisk       Boolean  @default(false)
  aiRequiredForVeryHighRisk   Boolean  @default(false)
  allowManualPaperWatchBuy    Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Per-user settings of the New Launch / Sniper strategy (PAPER only). Defaults are PAPER experiment values.
model NewLaunchConfig {
  id                         String   @id @default(cuid())
  userId                     String   @unique
  enabled                    Boolean  @default(false)
  minAgeSeconds              Int      @default(5)
  maxAgeSeconds              Int      @default(90)
  observationSeconds         Int      @default(10)
  cooldownSeconds            Int      @default(60)
  minTransactions            Int      @default(15)
  minUniqueBuyers            Int      @default(10)
  minBuySellRatio            Decimal  @default(1.5) @db.Decimal(6, 2)
  minLaunchVolumeUsd         Decimal  @default(2000) @db.Decimal(14, 2)
  minScore                   Int      @default(70)
  maxExhaustionScore         Int      @default(70)
  minLiquidityUsd            Decimal  @default(10000) @db.Decimal(14, 2)
  maxLiquidityUsd            Decimal? @db.Decimal(14, 2)
  maxPriceImpactPercent      Decimal  @default(3) @db.Decimal(6, 2)
  liquidityOutflowWarningPercent Decimal @default(25) @db.Decimal(6, 2)
  liquidityCriticalPercent   Decimal  @default(50) @db.Decimal(6, 2)
  maxRiskScore               Int      @default(80)
  maxPositionPercent         Decimal  @default(1) @db.Decimal(6, 2)
  maxConcurrentPositions     Int      @default(2)
  /// Distinct non-creator wallets whose sells must be observed before sellability counts as verified.
  minObservedSellers         Int      @default(1)
  /// Runs as a separate PAPER experiment next to Strategy/AI mode (central duplicate/risk controls still apply).
  independentMode            Boolean  @default(true)
  useAiConfirmation          Boolean  @default(false)
  /// Active experiment/config version (NL-v1, NL-v2, ...); a new version is created on every settings change.
  configVersion              String   @default("NL-v1")
  // --- NewLaunch-only exit strategy (independent of the Strategy/AI exit settings) ---
  stopLossPercent            Decimal  @default(20) @db.Decimal(6, 2)
  takeProfitPercent          Decimal  @default(25) @db.Decimal(7, 2)
  breakEvenEnabled           Boolean  @default(true)
  breakEvenActivationPercent Decimal  @default(10) @db.Decimal(6, 2)
  /// Break-even stop = entry fill * (1 + buffer%); 0.6 = the two PAPER fees (2 x 0.30%).
  breakEvenCostBufferPercent Decimal  @default(0.6) @db.Decimal(6, 3)
  // Exit capacity / dynamic position sizing (MONITOR_ONLY by default: recommendation only, size unchanged)
  dynamicPositionSizingEnabled   Boolean @default(true)
  exitCapacityMode               String  @default("MONITOR_ONLY")
  maxEstimatedEntryImpactPct     Decimal @default(3) @db.Decimal(6, 3)
  maxEstimatedExitImpactPct      Decimal @default(3) @db.Decimal(6, 3)
  maxEstimatedRoundTripImpactPct Decimal @default(6) @db.Decimal(6, 3)
  minExitCapacityScore           Int     @default(50)
  maxLiquidityUtilizationPct     Decimal @default(5) @db.Decimal(6, 3)
  minimumExecutablePosition      Decimal @default(5) @db.Decimal(18, 6)
  positionSizeStep               Decimal @default(1) @db.Decimal(18, 6)
  // Social Intelligence (deterministic; MONITOR_ONLY by default: never changes a decision)
  socialIntelligenceEnabled      Boolean @default(true)
  socialDecisionMode             String  @default("MONITOR_ONLY")
  aiSocialAnalysisEnabled        Boolean @default(false)
  trailingEnabled            Boolean  @default(true)
  trailingActivationPercent  Decimal  @default(15) @db.Decimal(6, 2)
  trailingDistancePercent    Decimal  @default(8) @db.Decimal(6, 2)
  /// Prepared only: tiered take-profit levels [{profitPercent, sellPercent}]; not executed while disabled.
  tieredTakeProfitEnabled    Boolean  @default(false)
  tieredTakeProfitLevels     Json?
  maxHoldEnabled             Boolean  @default(false)
  maxHoldMinutes             Int      @default(30)
  liquiditySafetyExitEnabled Boolean  @default(true)
  liquidityDropExitPercent   Decimal  @default(50) @db.Decimal(6, 2)
  /// Entry quality gate: {mode: OFF|MONITOR_ONLY|ENFORCE_PAPER, thresholds...}; null = MONITOR_ONLY defaults.
  qualityGate                Json?
  minimumRecommendationSampleSize Int @default(50)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Immutable history of NewLaunch configurations; trades reference the version they were opened with.
model NewLaunchConfigVersion {
  id                          String   @id @default(cuid())
  userId                      String
  version                     String
  versionNumber               Int
  entryConfig                 Json
  exitConfig                  Json
  qualityGate                 Json
  parentVersion               String?
  createdFromRecommendationId String?
  note                        String?
  createdAt                   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, version])
  @@index([userId, createdAt])
}

/// Real price-path metrics of a position (MFE / MAE / milestones), tracked live or backfilled from stored snapshots.
model PositionPathMetric {
  id                 String    @id @default(cuid())
  positionId         String    @unique
  userId             String
  decisionSource     String?
  configVersion      String?
  entryPrice         Decimal   @db.Decimal(30, 18)
  entryAt            DateTime
  quantity           Decimal   @db.Decimal(18, 8)
  maxPriceAfterEntry Decimal?  @db.Decimal(30, 18)
  minPriceAfterEntry Decimal?  @db.Decimal(30, 18)
  mfePercent         Decimal?  @db.Decimal(12, 4)
  mfeUsd             Decimal?  @db.Decimal(18, 8)
  timeToMfeMs        Int?
  maePercent         Decimal?  @db.Decimal(12, 4)
  maeUsd             Decimal?  @db.Decimal(18, 8)
  timeToMaeMs        Int?
  /// First time (ms after entry) each milestone was reached: {"+3": 1200, "-5": 8000, ...}.
  milestones         Json
  liquidityAtEntry   Decimal?  @db.Decimal(24, 8)
  lastLiquidityUsd   Decimal?  @db.Decimal(24, 8)
  minLiquidityUsd    Decimal?  @db.Decimal(24, 8)
  sampleCount        Int       @default(0)
  lastPriceAt        DateTime?
  /// LIVE_TRACKING (monitor loop) or SNAPSHOT_BACKFILL (stored market snapshots).
  source             String
  updatedAt          DateTime  @updatedAt

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([userId, decisionSource])
  @@index([userId, configVersion])
}

/// A completed (or failed) NewLaunch analysis/optimizer run; results are cached here for the UI.
model NewLaunchOptimizationRun {
  id          String    @id @default(cuid())
  userId      String
  status      String
  scope       Json
  sampleSize  Int       @default(0)
  result      Json?
  error       String?
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user            User                              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recommendations NewLaunchOptimizationRecommendation[]

  @@index([userId, startedAt])
}

/// A PAPER experiment suggestion; never applied without an explicit user action.
model NewLaunchOptimizationRecommendation {
  id              String    @id @default(cuid())
  userId          String
  runId           String
  parameter       String
  currentValue    Decimal?  @db.Decimal(20, 6)
  suggestedValue  Decimal?  @db.Decimal(20, 6)
  sampleSize      Int
  confidenceLevel String
  trainingMetrics Json
  validationMetrics Json
  tradeRetention  Decimal?  @db.Decimal(7, 4)
  winnerRetention Decimal?  @db.Decimal(7, 4)
  loserRejection  Decimal?  @db.Decimal(7, 4)
  reason          String
  warnings        Json
  /// PENDING | ACCEPTED | DISMISSED
  status          String    @default("PENDING")
  createdVersion  String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  user User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  run  NewLaunchOptimizationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

/// A newly detected token / pool (market-level, shared by all users). One row per mint.
model LaunchCandidate {
  id              String    @id @default(cuid())
  mint            String    @unique
  source          String
  poolAddress     String?
  bondingCurve    String?
  quoteMint       String?
  creator         String?
  name            String?
  symbol          String?
  /// When our system saw the event.
  detectedAt      DateTime
  /// Mint creation time on-chain, when known (block time of the create transaction).
  createdAt       DateTime?
  /// First time the token was tradable (first pool / bonding curve activity), when known.
  firstTradableAt DateTime?
  initialLiquidityUsd Decimal? @db.Decimal(18, 2)
  detectedPriceUsd    Decimal? @db.Decimal(30, 18)
  /// OBSERVING | EXPIRED | MIGRATED
  status          String    @default("OBSERVING")
  security        Json?
  /// Official social links from token metadata (twitter / telegram / website); null = not resolved yet
  socialLinks     Json?
  lastMetrics     Json?
  updatedAt       DateTime  @updatedAt

  snapshots LaunchSnapshot[]
  decisions LaunchDecision[]

  @@index([detectedAt])
  @@index([status])
}

/// Timestamped launch observation (real data only; null = not available).
model LaunchSnapshot {
  id              String   @id @default(cuid())
  candidateId     String
  takenAt         DateTime
  priceUsd        Decimal? @db.Decimal(30, 18)
  liquidityUsd    Decimal? @db.Decimal(18, 2)
  volumeUsd       Decimal? @db.Decimal(18, 2)
  buyCount        Int?
  sellCount       Int?
  buyVolumeUsd    Decimal? @db.Decimal(18, 2)
  sellVolumeUsd   Decimal? @db.Decimal(18, 2)
  uniqueBuyers    Int?
  uniqueSellers   Int?
  largestBuyerShare Decimal? @db.Decimal(6, 4)
  marketCapUsd    Decimal? @db.Decimal(20, 2)
  bondingProgress Decimal? @db.Decimal(6, 4)
  dataQuality     Int?

  candidate LaunchCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([candidateId, takenAt])
}

/// A user's NewLaunchStrategy decision for a candidate (stored when the decision changes).
model LaunchDecision {
  id                  String    @id @default(cuid())
  userId              String
  candidateId         String
  mint                String
  /// BUY | WATCH | REJECT
  decision            String
  status              String
  score               Int?
  launchMomentumScore Int?
  exhaustionScore     Int?
  liquidityScore      Int?
  buyerQualityScore   Int?
  buyPressureScore    Int?
  securityScore       Int?
  dataQuality         Int
  riskScore           Decimal?  @db.Decimal(5, 2)
  riskClassification  String?
  reasons             Json
  warnings            Json
  features            Json?
  signalId            String?
  detectedAt          DateTime
  securityCompletedAt DateTime?
  decisionAt          DateTime  @default(now())
  configVersion       String?
  /// Quality gate evaluation (only for BUY decisions): mode in force, would it pass, failed conditions.
  qualityGateMode     String?
  qualityGateWouldPass Boolean?
  qualityGateReasons  Json?
  /// Social Intelligence summary at decision time (shadow; also for rejected candidates)
  socialSummary       Json?

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  candidate LaunchCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  @@index([userId, decisionAt])
  @@index([userId, mint])
  @@index([decision])
}

/// Real lifecycle events of a position (entry, break-even, trailing moves, warnings, exits) for the timeline/chart.
model PositionEvent {
  id         String   @id @default(cuid())
  positionId String
  userId     String
  type       String
  at         DateTime @default(now())
  price      Decimal? @db.Decimal(30, 18)
  details    Json?

  position Position @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@index([positionId, at])
  @@index([userId])
}

/// Per-user AI token analysis settings. aiAnalysisEnabled switches the automatic entry decision source to AI.
model AiConfig {
  id                              String   @id @default(cuid())
  userId                          String   @unique
  aiAnalysisEnabled               Boolean  @default(false)
  aiMinimumConfidence             Int      @default(75)
  aiRecheckSeconds                Int      @default(30)
  aiMaxAnalysesPerMinute          Int      @default(10)
  aiAllowHighRisk                 Boolean  @default(true)
  aiAllowVeryHighRisk             Boolean  @default(false)
  aiDynamicExitSuggestionsEnabled Boolean  @default(false)
  aiDecisionTtlSeconds            Int      @default(180)
  /// Use the AI's SL/TP/trailing suggestions (validated) instead of the user's settings. Off by default.
  aiUseExitParameters             Boolean  @default(false)
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// One AI token analysis (authoritative record; Redis only caches). Failed/invalid attempts are stored too.
model AiAnalysis {
  id                                 String    @id @default(cuid())
  userId                             String
  tokenId                            String
  tokenAddress                       String
  provider                           String
  model                              String
  promptVersion                      String
  riskAssessmentId                   String?
  /// COMPLETED | FAILED | INVALID
  status                             String
  rawDecision                        String?
  /// BUY | WATCH | SKIP | NONE
  effectiveDecision                  String
  effectiveReason                    String?
  confidence                         Decimal?  @db.Decimal(5, 2)
  entryQuality                       Decimal?  @db.Decimal(5, 2)
  marketStrength                     Decimal?  @db.Decimal(5, 2)
  momentumQuality                    Decimal?  @db.Decimal(5, 2)
  liquidityQuality                   Decimal?  @db.Decimal(5, 2)
  timingQuality                      Decimal?  @db.Decimal(5, 2)
  exhaustionRisk                     Decimal?  @db.Decimal(5, 2)
  recommendedPositionMultiplier      Decimal?  @db.Decimal(5, 4)
  suggestedStopLossPercent           Decimal?  @db.Decimal(7, 2)
  suggestedTakeProfitPercent         Decimal?  @db.Decimal(7, 2)
  suggestedTrailingActivationPercent Decimal?  @db.Decimal(7, 2)
  suggestedTrailingDistancePercent   Decimal?  @db.Decimal(7, 2)
  recheckSeconds                     Int?
  reasons                            Json?
  warnings                           Json?
  errorMessage                       String?
  inputHash                          String
  marketStateHash                    String
  /// Point-in-time structured input that was sent (public market/risk data only).
  input                              Json?
  latencyMs                          Int?
  inputTokens                        Int?
  outputTokens                       Int?
  cached                             Boolean   @default(false)
  createdAt                          DateTime  @default(now())
  expiresAt                          DateTime

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  token Token @relation(fields: [tokenId], references: [id])

  @@index([userId, tokenId, createdAt])
  @@index([userId, createdAt])
}

/// Per-user settings of the advanced short-term signal modules and the composite signal (PAPER experimentation).
model AdvancedStrategyConfig {
  id                              String   @id @default(cuid())
  userId                          String   @unique
  /// Composite signal may create BUY signals (off by default: analysis only).
  compositeEnabled                Boolean  @default(false)
  minimumConfirmations            Int      @default(3)
  minimumCompositeScore           Int      @default(65)
  /// Count enabled-but-unavailable modules as zero instead of leaving them out.
  penalizeUnavailable             Boolean  @default(false)
  exhaustionEnabled               Boolean  @default(true)
  exhaustionWarningThreshold      Int      @default(40)
  exhaustionStrongWarningThreshold Int     @default(70)
  exhaustionBlockThreshold        Int      @default(85)
  /// BLOCK: no automatic entry at/above the block threshold; WARN_ONLY: warnings and composite penalty only.
  exhaustionPolicy                String   @default("BLOCK")
  exhaustionPenaltyWeight         Decimal  @default(0.5) @db.Decimal(5, 3)
  /// Close open PAPER positions whose pool liquidity collapsed (off by default).
  liquidityOutflowExitEnabled     Boolean  @default(false)
  liquidityOutflowExitPercent     Decimal  @default(50) @db.Decimal(5, 2)
  /// Per-module settings: { [module]: { enabled, weight, minScore, ...params } } merged over code defaults.
  modules                         Json?
  createdAt                       DateTime @default(now())
  updatedAt                       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model StrategyConfig {
  id          String   @id @default(cuid())
  userId      String
  strategyName String
  isEnabled   Boolean  @default(false)
  params      Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

