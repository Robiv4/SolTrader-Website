/// Timestamped Social Intelligence snapshot of a token (public social data; computed from events known at `at`).
model SocialSnapshot {
  id                   String   @id @default(cuid())
  mint                 String
  at                   DateTime
  socialScore          Int?
  momentumScore        Int?
  qualityScore         Int?
  spamScore            Int?
  exhaustionScore      Int?
  dataQuality          Int?
  confirmation         String
  shadowDecision       String
  mentionTrend         String
  tokenMatchConfidence Decimal? @db.Decimal(5, 3)
  matchBasis           String
  mentions5m           Int?
  uniqueAuthors5m      Int?
  freshness            String
  /// Window metrics, per-source metrics, reasons / warnings, provider states
  details              Json
  createdAt            DateTime @default(now())

  @@index([mint, at])
}


/// Telegram source registry (Telegram-first Social Intelligence). Only public chats / chats the configured account is
/// legitimately allowed to read; private invite links are recorded as NO_ACCESS and never joined.
model TelegramSource {
  id                String    @id @default(cuid())
  tokenId           String?
  mint              String
  telegramEntityId  String?
  telegramUsername  String?
  telegramUrl       String?
  /// CHANNEL | GROUP | SUPERGROUP | UNKNOWN
  sourceType        String    @default("UNKNOWN")
  /// OFFICIAL | PROBABLE_OFFICIAL | COMMUNITY | UNKNOWN
  officialStatus    String    @default("UNKNOWN")
  discoveredAt      DateTime  @default(now())
  lastVerifiedAt    DateTime?
  /// MINT_ADDRESS | OFFICIAL_SOCIAL_LINK | VERIFIED_LINK | EXACT_PROJECT_NAME | TICKER
  matchBasis        String
  matchConfidence   Decimal   @db.Decimal(5, 3)
  active            Boolean   @default(true)
  /// ACCESSIBLE | NO_ACCESS | NOT_FOUND | RATE_LIMITED | UNKNOWN
  accessStatus      String    @default("UNKNOWN")
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([mint, telegramUsername])
  @@index([mint])
  @@index([telegramUsername])
}

/// IP addresses a user has confirmed with an e-mailed code. The IP itself is stored only as a keyed hash.
model TrustedLoginIp {
  id          String   @id @default(cuid())
  userId      String
  ipHash      String
  /// Masked hint for display (e.g. 192.168.*.*); never the full address.
  ipHint      String
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ipHash])
  @@index([userId])
}

/// One-time e-mail verification codes: login from a new IP, or confirmation of a sensitive admin action.
model VerificationChallenge {
  id          String    @id @default(cuid())
  userId      String
  /// LOGIN_NEW_IP | ADMIN_ACTION
  purpose     String
  /// e.g. admin_user_create, admin_role_change, admin_user_delete, live_enable
  action      String
  /// Keyed hash binding the code to the exact action parameters (a code cannot approve a different action).
  actionHash  String
  codeHash    String
  ipHash      String?
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// ML (shadow only): immutable feature snapshot of a candidate at a defined prediction point. Written once, never
/// updated with later information (outcomes live in MlCandidateOutcome).
model MlFeatureSnapshot {
  id               String   @id @default(cuid())
  /// LaunchCandidate id (candidate = one launch / mint observed by the system)
  candidateId      String
  mint             String
  source           String
  /// Prediction point: AGE_15S | AGE_30S | AGE_60S | BUY_DECISION
  kind             String
  snapshotAt       DateTime
  detectedAt       DateTime
  featureVersion   String
  features         Json
  /// Observation time per feature group (leakage audit)
  observedAt       Json
  dataQuality      Int
  validForTraining Boolean
  invalidReasons   Json
  /// SolTrader decision context at snapshot time (best across users: BUY > WATCH > REJECT) + per-user details
  decision         String
  decisionContext  Json
  newLaunchConfigVersion String?
  referencePriceUsd Decimal? @db.Decimal(30, 18)
  /// Set when a PAPER position was opened for this candidate (link only, no duplicated data)
  positionId       String?
  createdAt        DateTime @default(now())

  outcome     MlCandidateOutcome?
  predictions MlPrediction[]

  @@unique([candidateId, kind, featureVersion])
  @@index([snapshotAt])
  @@index([mint])
  @@index([kind, featureVersion, snapshotAt])
}

/// Shadow outcome after a snapshot (real observed market data only; compact bucketed price path).
model MlCandidateOutcome {
  id            String   @id @default(cuid())
  snapshotId    String   @unique
  mint          String
  labelVersion  String
  /// TRACKING | COMPLETE | PARTIAL | INSUFFICIENT
  status        String
  entryPriceUsd Decimal  @db.Decimal(30, 18)
  result        Json?
  path          Json
  validHorizons Json
  endReason     String?
  trackingEndedAt DateTime?
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())

  snapshot MlFeatureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@index([status])
}

/// Immutable dataset version (rows file on disk, hash recorded).
model MlDatasetVersion {
  id             String   @id @default(cuid())
  version        String   @unique
  featureVersion String
  labelVersion   String
  target         String
  config         Json
  manifest       Json
  rowCount       Int
  filePath       String
  fileHash       String
  createdBy      String?
  createdAt      DateTime @default(now())
}

/// Trained model (artifact JSON on disk, hash recorded). Status changes only by explicit admin action.
model MlModelVersion {
  id             String   @id @default(cuid())
  version        String   @unique
  algorithm      String
  /// TRAINED | VALIDATED | SHADOW | PAPER_APPROVED | PAPER_ACTIVE | RETIRED (this release: up to SHADOW)
  status         String   @default("TRAINED")
  readiness      String
  featureVersion String
  labelVersion   String
  target         String
  datasetVersion String
  config         Json
  metrics        Json
  artifactPath   String
  artifactHash   String
  statusHistory  Json
  createdBy      String?
  trainedAt      DateTime
  createdAt      DateTime @default(now())
}

/// Shadow prediction (never used by trading).
model MlPrediction {
  id               String   @id @default(cuid())
  snapshotId       String
  modelVersion     String
  mint             String
  probability      Decimal  @db.Decimal(8, 6)
  calibrated       Boolean
  mlEntryScore     Int
  predictedClass   String
  dataQuality      Int
  contributions    Json?
  latencyMs        Decimal  @db.Decimal(10, 3)
  predictedAt      DateTime @default(now())

  snapshot MlFeatureSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, modelVersion])
  @@index([modelVersion, predictedAt])
}
