model Position {
  id               String      @id @default(cuid())
  userId           String
  tokenId          String
  signalId         String?
  strategyId       String?
  side             TradeSide
  quantity         Decimal     @db.Decimal(18, 8)
  avgEntryPrice    Decimal     @db.Decimal(30, 18)
  currentPrice     Decimal?    @db.Decimal(30, 18)
  stopLossPrice    Decimal?    @db.Decimal(30, 18)
  takeProfitPrice  Decimal?    @db.Decimal(30, 18)
  trailingStopPercent Decimal?  @db.Decimal(5, 4)
  /// Market (reference) price at entry; avgEntryPrice is the simulated fill including slippage.
  entryMarketPrice Decimal?    @db.Decimal(30, 18)
  /// Fraction above the entry fill at which trailing arms (0.15 = +15%); null = armed from entry (legacy positions).
  trailingActivationPercent Decimal? @db.Decimal(7, 4)
  trailingActive   Boolean     @default(false)
  trailingActivatedAt DateTime?
  /// Market price at which trailing armed.
  trailingActivationPrice Decimal? @db.Decimal(30, 18)
  /// Current trailing trigger; only ever moves up.
  trailingTriggerPrice Decimal? @db.Decimal(30, 18)
  /// Fraction above the entry fill at which the stop moves to break-even; null = disabled.
  breakEvenActivationPercent Decimal? @db.Decimal(7, 4)
  breakEvenAppliedAt DateTime?
  /// Pool liquidity at entry, used by the optional liquidity-outflow exit.
  entryLiquidityUsd Decimal?   @db.Decimal(24, 8)
  /// Exit policy the position was opened with ('NEW_LAUNCH' = NewLaunch exit settings; null = global/strategy).
  exitPolicy       String?
  /// NewLaunch config version in force at entry (e.g. NL-v3).
  configVersion    String?
  /// Snapshotted liquidity-safety exit threshold (percent drop vs entry liquidity); null = use owner setting.
  liquidityExitPercent Decimal? @db.Decimal(6, 2)
  /// Optional time-based exit (NewLaunch max hold); null = no time limit.
  maxHoldUntil     DateTime?
  /// Break-even cost buffer snapshotted at entry (fraction above the entry fill); null = the two PAPER fees.
  breakEvenCostBuffer Decimal? @db.Decimal(8, 6)
  highestPrice     Decimal?    @db.Decimal(30, 18)
  lowestPrice      Decimal?    @db.Decimal(30, 18)
  unrealizedPnl    Decimal?    @db.Decimal(18, 8)
  realizedPnl      Decimal?    @db.Decimal(18, 8)
  exitReason       String?
  status           TradeStatus @default(OPEN)
  mode             TradingMode @default(PAPER)
  openedAt         DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  closedAt         DateTime?

  user     User      @relation(fields: [userId], references: [id])
  token    Token     @relation(fields: [tokenId], references: [id])
  signal   Signal?   @relation(fields: [signalId], references: [id])
  strategy Strategy? @relation(fields: [strategyId], references: [id])
  trades   Trade[]

  @@index([userId, status])
  @@index([tokenId])
  @@index([signalId])
  @@index([mode])
  @@index([userId, configVersion])
  @@index([userId, closedAt])
  events PositionEvent[]
  pathMetric PositionPathMetric?
}

model Trade {
  id                  String         @id @default(cuid())
  userId              String
  tokenId             String
  strategyId          String?
  signalId            String?
  positionId          String?
  side                TradeSide
  tokenAddress        String
  symbol              String
  strategyName        String?
  signalScore         Decimal?       @db.Decimal(5, 2)
  riskScore           Decimal?       @db.Decimal(5, 2)
  riskClassification  RiskClassification?
  riskPolicy          RiskPolicy?
  aiConfirmed         Boolean        @default(false)
  aiOpportunityScore  Decimal?       @db.Decimal(5, 2)
  aiConfidence        Decimal?       @db.Decimal(5, 2)
  entry               Decimal?       @db.Decimal(30, 18)
  exit                Decimal?       @db.Decimal(30, 18)
  size                Decimal?       @db.Decimal(18, 8)
  quantity            Decimal?       @db.Decimal(18, 8)
  fees                Decimal?       @db.Decimal(18, 8)
  slippage            Decimal?       @db.Decimal(18, 8)
  pnl                 Decimal?       @db.Decimal(18, 8)
  netPnl              Decimal?       @db.Decimal(18, 8)
  exitReason          String?
  transactionSignature String?
  paperDecision       Json?
  executionDelayMs    Int?
  priorityFee         Decimal?       @db.Decimal(18, 8)
  partialFillRatio    Decimal?       @db.Decimal(5, 4)
  stopLoss            Decimal?       @db.Decimal(30, 18)
  takeProfit          Decimal?       @db.Decimal(30, 18)
  trailingStop        Decimal?       @db.Decimal(5, 4)
  /// Reference market prices; entry/exit are the simulated fills.
  entryMarketPrice    Decimal?       @db.Decimal(30, 18)
  exitMarketPrice     Decimal?       @db.Decimal(30, 18)
  /// Exit slippage cost in USD; slippage holds the total (entry + exit) once closed.
  exitSlippage        Decimal?       @db.Decimal(18, 8)
  /// Settings in force when the position was opened (for later comparison).
  configSnapshot      Json?
  /// Why/how the position closed: trigger levels, peak, trailing state, fill assumptions.
