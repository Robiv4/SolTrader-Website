    "@soltrader/token-discovery": "workspace:*",
    "@soltrader/trading-engine": "workspace:*",
    "dotenv": "^16.4.5",
    "pino": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "redis": "^4.6.15",
    "telegram": "2.26.22",
    "zod": "^3.23.8"
