# Application
NODE_ENV=development
APP_ENV=development
APP_NAME=soltrader
LOG_LEVEL=info

# API
API_PORT=3001
API_HOST=0.0.0.0
ADMIN_EMAIL=admin@example.invalid
ADMIN_PASSWORD=
SESSION_TTL_SECONDS=1800

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Worker
WORKER_PORT=3002

# Database
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
DATABASE_URL=
# For Compose containers, use service hostnames: postgres and redis.
DATABASE_URL_DOCKER=

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_PORT=6379

# Trading modes
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
LIVE_TRADING_REQUIRES_APPROVAL=true

# Security
JWT_SECRET=
SESSION_SECRET=

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WS_URL=wss://api.mainnet-beta.solana.com/
SOLANA_NETWORK=mainnet-beta

# RPC providers
HELIUS_API_KEY=
CORS_ORIGINS=http://localhost:3000
MARKET_DATA_PROVIDER=dexscreener
MARKET_DATA_PROVIDER_URL=
MARKET_DATA_CACHE_TTL_SECONDS=30
MARKET_DATA_POLL_INTERVAL_MS=15000
MARKET_DATA_REQUEST_TIMEOUT_MS=5000
MARKET_DATA_DISCOVERY_LIMIT=30
MARKET_DATA_STALE_AFTER_MS=120000

# Paper trading defaults
MAX_POSITION_PERCENT=2
MAX_TOTAL_EXPOSURE_PERCENT=25
MAX_SIMULTANEOUS_POSITIONS=5
DAILY_LOSS_LIMIT_PERCENT=5
MAX_SLIPPAGE_PERCENT=3
MIN_SIGNAL_SCORE=70

# Live trading safety prerequisites remain disabled by default
DEDICATED_TRADING_WALLET_ADDRESS=
RPC_HEALTHY=false
MARKET_DATA_HEALTHY=false
EXECUTION_PROVIDER_URL=
RISK_LIMITS_CONFIGURED=false
DAILY_LOSS_LIMIT_CONFIGURED=false
MAX_POSITION_CONFIGURED=false
MAX_EXPOSURE_CONFIGURED=false
SLIPPAGE_LIMIT_CONFIGURED=false
PAPER_TRADING_COMPLETED=false
PAPER_TRADING_COMPLETED_TRADES=0
CRITICAL_SYSTEM_ERRORS=0

# E-mail verification codes: login from a new IP, and sensitive admin actions (code goes to the acting admin).
# Default on. Without SMTP outside production the codes are printed to the API console (development only);
# in production a missing SMTP blocks those logins / actions (fail closed).
EMAIL_VERIFICATION_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Telegram notifications
TELEGRAM_NOTIFICATIONS_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_THROTTLE_MS=60000
SOLANA_PRIMARY_RPC_URL=
SOLANA_SECONDARY_RPC_URL=
SOLANA_FALLBACK_RPC_URL=
SOLANA_RPC_TIMEOUT_MS=5000
SOLANA_RPC_RATE_LIMIT_COOLDOWN_MS=30000
# Shared SolanaRpcManager (worker). 1-3 providers; secondary / fallback are optional. Never put keys in logs / UI:
# providers are shown as role + host only. A keyless https://rpc.ankr.com/solana answers 403 for every call.
SOLANA_RPC_MAX_CONCURRENCY=8
SOLANA_RPC_QUEUE_LIMIT=1000
SOLANA_RPC_RATE_LIMIT_BASE_MS=2000
SOLANA_RPC_FORBIDDEN_RECHECK_MS=1800000
SOLANA_RPC_CACHE_ENABLED=true
SOLANA_RPC_DEDUP_ENABLED=true
SOLANA_RPC_BATCHING_ENABLED=true
SOLANA_COMMITMENT=confirmed

# AI Token Analyzer (optional). Server-side secrets only: never exposed to the browser, API responses, logs or SSE.
# Users switch AI mode on/off per account in Settings (stored in PostgreSQL); without a key AI mode cannot be enabled.
# AI_PROVIDER: groq (Llama 3 / DeepSeek), xai (Grok) or openai. AI_MODEL must be available to the key,
# e.g. openai/gpt-oss-120b (default for groq), qwen/qwen3.8-27b, grok-4 (default for xai).
AI_PROVIDER=
AI_MODEL=
GROQ_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
AI_REQUEST_TIMEOUT_MS=15000
AI_MAX_RETRIES=2
AI_MAX_ANALYSES_PER_MINUTE=30
AI_CONCURRENCY=2

# Separate, EMPTY database used only by `prisma migrate dev` (Prisma resets it). Never the same as DATABASE_URL.
# Optional: the project scripts create migrations with `pnpm db:create-migration <name>` without any shadow DB.
# SHADOW_DATABASE_URL=postgresql://soltrader:soltrader@localhost:5432/soltrader_shadow?schema=public

# Exit Engine: quotes older than this are flagged EXIT_DATA_STALE (ms); NewLaunch fast exit loop interval (ms, 0 = off).
EXIT_MARKET_DATA_MAX_AGE_MS=15000
NEW_LAUNCH_EXIT_LOOP_MS=1000
# NewLaunch event-driven exit monitor: stream stale threshold, fallback polling, non-critical persistence throttle (ms).
NEW_LAUNCH_EXIT_STREAM_STALE_MS=5000
NEW_LAUNCH_EXIT_FALLBACK_POLL_MS=2000
NEW_LAUNCH_EXIT_PERSIST_THROTTLE_MS=1000
# Simulated PAPER execution latency between exit trigger and fill: NONE (default) | FIXED | RANGE | EMPIRICAL.
PAPER_EXIT_LATENCY_MODE=NONE
# PAPER_EXIT_LATENCY_FIXED_MS=300
# PAPER_EXIT_LATENCY_MIN_MS=150
# PAPER_EXIT_LATENCY_MAX_MS=800
# PAPER_EXIT_LATENCY_P50_MS=
# PAPER_EXIT_LATENCY_P75_MS=
# PAPER_EXIT_LATENCY_P95_MS=

# Social Intelligence (deterministic, MONITOR_ONLY, no AI). Telegram-first; X optional and OFF by default.
SOCIAL_COLLECTION_ENABLED=true
# Telegram MTProto (https://my.telegram.org -> API development tools). Create the session string with:
#   pnpm --filter @soltrader/worker telegram:login
# TELEGRAM_SESSION is a secret (full account access): never commit, log or share it.
TELEGRAM_SOCIAL_ENABLED=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=
TELEGRAM_MAX_MONITORED_SOURCES=50
TELEGRAM_GLOBAL_SEARCH_PER_MIN=2
# X (optional): with X_SOCIAL_ENABLED=false no X request is made at all.
X_SOCIAL_ENABLED=false
# X_API_BEARER_TOKEN=
X_API_MAX_REQUESTS_PER_15MIN=50
# Optional AI social analysis (off = zero LLM calls).
AI_SOCIAL_ANALYSIS_ENABLED=false

# Community Intelligence (MONITOR_ONLY): inputs of ML-FEATURES-COMMUNITY-v1 models only. Never makes, blocks or sizes a
# trade; an outage only removes community data (worker and Exit Engine keep running).
COMMUNITY_INTELLIGENCE_ENABLED=true
COMMUNITY_INTELLIGENCE_MODE=MONITOR_ONLY
# DEX Screener public API (no key; documented limit 60-300/min - we stay below it, 30 tokens per request)
DEXSCREENER_ENABLED=true
DEXSCREENER_REQUESTS_PER_MINUTE=40
DEXSCREENER_CACHE_TTL_MS=60000
# On-chain community statistics from the existing launch trade stream (no extra Helius requests)
HELIUS_COMMUNITY_ENABLED=true
# LunarCrush (optional, paid API v4). Without a key: NOT_CONFIGURED, zero requests. The key is a secret.
LUNARCRUSH_ENABLED=false
LUNARCRUSH_API_KEY=
LUNARCRUSH_REQUESTS_PER_MINUTE=5
LUNARCRUSH_CACHE_TTL_MS=1800000
COMMUNITY_REQUEST_TIMEOUT_MS=6000
COMMUNITY_BACKOFF_BASE_MS=2000
COMMUNITY_BACKOFF_MAX_MS=300000

# Machine Learning (local statistical ML; SHADOW only - no trading influence, no LLM).
# OFF | SHADOW (ENFORCE_PAPER is not available in this release; LIVE is never an ML mode)
ML_MODE=SHADOW
# Max concurrently tracked 60-minute outcome paths (memory only; beyond it ML degrades, trading does not)
ML_MAX_TRACKED_CANDIDATES=3000
# Market-data budget for sources without a trade stream (Raydium / Meteora), requests per minute
ML_MAX_MARKET_DATA_PER_MIN=20
# Snapshot kinds that get an outcome path (AGE_15S, AGE_30S, AGE_60S, BUY_DECISION)
ML_OUTCOME_KINDS=AGE_30S,BUY_DECISION
